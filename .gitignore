# ─── 인증 정보 — 절대 커밋 금지 ────────────────────────────────
.credentials/
*.json
!*.json.example
.env

# 개인 환경 설정 (Figma 토큰·로컬 권한 포함)
.claude/settings.json
.claude/settings.local.json

# ─── 사내 자료 (기획서 원본·캡처) ──────────────────────────────
PDF/
*.pdf
img/
scratchpad_crops/

